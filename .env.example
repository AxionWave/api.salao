# Copie para .env (docker compose) ou exporte no shell.
# Os valores DEV devem ser IGUAIS aos do oAuth / Gateway.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8092

JWT_SECRET=defaultSecretKeyForJWTTokenGenerationAndValidation
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=oauth-api

# Postgres compartilhado (schema lyra). Porta 5433 = docker-compose.infra.yml
ConnectionStrings__Default=Host=localhost;Port=5433;Database=base;Username=postgres;Password=postgres;Search Path=lyra

EUREKA_URL=http://localhost:8761/eureka/
